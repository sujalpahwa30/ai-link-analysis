# Copy this file to .env and fill in at least one provider key.
APP_NAME="AI Link Analysis API"
ENVIRONMENT=development
LOG_LEVEL=INFO

# auto = Gemini if configured, then the OpenAI-compatible slot, then deterministic demo mode.
LLM_PROVIDER=auto
ENABLE_LLM_FALLBACK=true

# Google Gemini (primary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI-compatible slot: OpenAI, Groq, or OpenRouter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=none

# Free-tier Groq fallback (recommended). Uncomment these three lines:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-120b
# OPENAI_REASONING_EFFORT=low

# Limits and caching
MAX_PAGE_BYTES=2000000
MAX_CONTENT_CHARS=18000
MAX_REDIRECTS=3
FETCH_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=5000
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=256
# Groq's free tier is 8,000 TPM; with it, use MAX_CONTENT_CHARS=8000 and LLM_MAX_OUTPUT_TOKENS=3000.

# Per-client limit for POST /link-analysis (health and docs stay exempt).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Comma-separated origins. Leave empty for same-origin only.
CORS_ORIGINS=
