# Copy this file to .env and fill in one provider key.
APP_NAME="AI Link Analysis API"
ENVIRONMENT=development
LOG_LEVEL=INFO

# auto = Gemini if configured, then OpenAI, then deterministic demo mode.
LLM_PROVIDER=auto
ENABLE_LLM_FALLBACK=true

# Google Gemini (default: fastest balance of structured JSON, context and cost)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI (cost-first alternative / fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=none

# Limits and caching
MAX_PAGE_BYTES=2000000
MAX_CONTENT_CHARS=18000
MAX_REDIRECTS=3
FETCH_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=5000
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=256

# Comma-separated origins. Leave empty for same-origin only.
CORS_ORIGINS=
